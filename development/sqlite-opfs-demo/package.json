{
  "name": "sqlite-opfs-demo",
  "description": "Demo for using SQLite in the browser with OPFS, to be removed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.app.json && vite build",
    "cypress": "pnpm with-server \"pnpm run cypress:open\"",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "dev": "vite --host",
    "dev:e2e": "vite --port 5174 --strictPort",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "pnpm test:cypress",
    "test:debug": "cross-env LOG_LEVEL=debug pnpm test",
    "test:cypress": "concurrently --kill-others --success first \"pnpm run dev\" \"wait-on http://localhost:5174 && cypress run\"",
    "with-server": "start-server-and-test \"pnpm run dev\" http://localhost:5174 \"pnpm run cypress:run\""
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "catalog:",
    "@tailwindcss/vite": "^4.1.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.2.0",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.1",
    "cross-env": "catalog:",
    "cypress": "^14.5.3",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "start-server-and-test": "^2.0.13",
    "ts-node": "^10.9.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wait-on": "^9.0.1"
  }
}
