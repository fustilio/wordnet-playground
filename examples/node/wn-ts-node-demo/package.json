{
  "name": "wn-ts-node-demo",
  "version": "0.1.0",
  "type": "module",
  "description": "Comprehensive demonstrations of the wn-ts library capabilities",
  "main": "src/run-all-use-cases.js",
  "scripts": {
    "demo": "node src/examples/basic/database-statistics.js",
    "kitchen-sink": "node src/examples/advanced/kitchen-sink-demo.js",
    "use-cases": "node src/run-all-use-cases.js",
    "live-demo": "node src/examples/advanced/live-demo.js",
    "crossword": "node src/examples/advanced/crossword-demo.js",
    "french-crossword": "node src/examples/advanced/french-crossword-demo.js",
    "multilingual": "node src/examples/advanced/multilingual-linking.js",
    "disambiguation": "node src/examples/advanced/word-sense-disambiguation.js",
    "exploration": "node src/examples/advanced/lexical-database-exploration.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:e2e": "vitest run test/e2e",
    "test:e2e:basic": "vitest run test/e2e/basic-tests.js",
    "test:e2e:advanced": "vitest run test/e2e/advanced-tests.js",
    "test:e2e:live": "vitest run test/e2e/live-tests.js",
    "test:e2e:performance": "vitest run test/e2e/performance-tests.js"
  },
  "dependencies": {
    "wn-ts-node": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "@vitest/ui": "catalog:",
    "turbo": "catalog:"
  },
  "keywords": [
    "wordnet",
    "nlp",
    "natural-language-processing",
    "lexical-database",
    "semantic-analysis",
    "multilingual",
    "demo",
    "examples"
  ],
  "author": "WordNet TypeScript Team",
  "license": "MIT"
}