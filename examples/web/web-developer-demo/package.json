{
  "name": "wn-ts-web-developer-demo",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --build --noEmit",
    "build": "tsc -b && vite build",
    "cypress": "pnpm with-server \"pnpm run cypress:open\"",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "dev": "concurrently --kill-others \"pnpm --filter wn-ts-web dev\" \"pnpm --filter wn-ts-web-developer-demo dev:start-server\" ",
    "dev:start-server": "vite",
    "dev:e2e": "vite --port 5174 --strictPort",
    "index:build": "pnpm -C ../wn-ts-web node scripts/build-index.js",
    "lexicon:generate": "node scripts/generate-th-en-lexicon.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:all": "pnpm test:e2e",
    "test:e2e": "pnpm test:cypress",
    "test:cypress": "pnpm with-server \"pnpm run cypress:run\"",
    "test:cypress:examples": "pnpm with-server \"cypress run --spec cypress/e2e/1-getting-started/todo.cy.ts\"",
    "test:cypress:local": "pnpm run index:build && pnpm run lexicon:generate && pnpm with-server \"cypress run --spec cypress/e2e/wordnet-demo/local-lexicon.cy.ts\"",
    "with-server": "start-server-and-test \"pnpm run dev:e2e\" http://localhost:5174"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@sqlite.org/sqlite-wasm": "catalog:",
    "@tailwindcss/vite": "^4.1.11",
    "pako": "^2.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-force-graph-2d": "^1.28.0",
    "tailwindcss": "^4.1.11",
    "utils": "workspace:*",
    "wn-ts-web": "workspace:*"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.2.0",
    "@types/pako": "^2.0.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^4.6.0",
    "comlink": "catalog:",
    "cross-env": "catalog:",
    "cypress": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "start-server-and-test": "catalog:",
    "ts-node": "^10.9.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-comlink": "catalog:",
    "vitest": "3.2.4",
    "@vitest/ui": "3.2.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "jsdom": "^25.0.1",
    "turbo": "catalog:"
  }
}
