{
  "name": "wordnet-workspace",
  "version": "0.7.2",
  "private": true,
  "description": "WordNet Client in TypeScript with demo and benchmarks",
  "repository": {
    "type": "git",
    "url": "https://github.com/fustilio/wordnet-playground.git"
  },
  "license": "MIT",
  "author": "fustilio",
  "type": "module",
  "scripts": {
    "docs:build": "pnpm --filter docs docs:build",
    "autotest": "pnpm --filter wn-ts-node vitest quarantine",
    "benchmark": "pnpm --filter benchmark test:bench",
    "benchmark:cross": "pnpm --filter benchmark test:bench:cross",
    "benchmark:func": "pnpm --filter benchmark test:func",
    "benchmark:lmf": "pnpm --filter benchmark test:bench:lmf",
    "benchmark:operations": "pnpm --filter benchmark test:bench:operations",
    "benchmark:parity": "pnpm --filter benchmark test:parity",
    "benchmark:perf": "pnpm --filter benchmark test:perf",
    "build": "turbo run build",
    "build:demo": "pnpm build && pnpm demo",
    "ci:benchmark": "echo '📊 Running benchmark functional tests...' && pnpm benchmark:func && echo '📊 Running benchmark parity tests...' && pnpm benchmark:parity && echo '📊 Running benchmark performance tests...' && pnpm benchmark:perf",
    "ci:build": "echo '🔨 Building wn-ts library...' && pnpm build",
    "ci:demo": "echo '🎭 Running all demo use cases...' && pnpm demo:all-use-cases",
    "ci:full": "pnpm run ci:build && pnpm run ci:test && pnpm run ci:demo && pnpm run ci:benchmark",
    "ci:test": "echo '🧪 Running all tests...' && pnpm test:all",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "clean": "pnpm --filter wn-ts-core clean",
    "demo": "pnpm --filter wn-ts-node-demo test",
    "demo:all-use-cases": "pnpm --filter wn-ts-node-demo all-use-cases",
    "demo:kitchen-sink": "pnpm --filter wn-ts-node-demo kitchen-sink",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:web:browser": "pnpm test:web && pnpm test:browser",
    "test:lmf": "pnpm -r test:lmf",
    "test:core": "pnpm --filter wn-ts-core test",
    "test:node": "pnpm --filter wn-ts-node test",
    "test:web": "pnpm --filter wn-ts-web test",
    "test:browser": "pnpm --filter wn-ts-web-demo test",
    "test:bench": "pnpm --filter wn-ts-core test:bench",
    "test:coverage": "pnpm --filter wn-ts-core test:coverage",
    "test:all": "turbo run test:all",
    "test:e2e": "turbo run test:e2e",
    "cleanup:temp": "node scripts/cleanup-temp-dirs.cjs",
    "test:clean": "pnpm test && pnpm cleanup:temp",
    "dev": "pnpm --filter wn-cli... dev",
    "suite": "pnpm build && pnpm test",
    "evaluate-duplicates": "pnpx jscpd --ignore \"node_modules,dist\" packages/wn-ts-core/src"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "turbo": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.14.0"
}
