{
  "name": "wn-data-loader",
  "version": "0.1.0",
  "description": "WordNet-specific extension of @fustilio/data-loader for lexical data processing",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:unit": "vitest run src/__tests__/unit.test.ts --reporter=verbose",
    "test:decompression": "vitest run src/__tests__/decompression.test.ts --reporter=verbose",
    "test:all": "vitest run src/__tests__/unit.test.ts src/__tests__/decompression.test.ts --reporter=verbose",
    "build": "tsc --noEmit",
    "dev": "tsc --watch --noEmit",
    "build:data-sources": "node ./scripts/build-data-sources.js",
    "prebuild": "npm run build:data-sources"
  },
  "dependencies": {
    "@fustilio/data-loader": "catalog:",
    "fast-xml-parser": "^5.2.5",
    "smol-toml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "wordnet",
    "lexical-data",
    "xml-processing",
    "data-loader",
    "linguistics"
  ],
  "author": "fustilio",
  "license": "MIT"
}