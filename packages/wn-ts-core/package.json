{
  "name": "wn-ts-core",
  "version": "0.5.2",
  "description": "Wordnet interface library - TypeScript port",
  "keywords": [
    "wordnet",
    "interlingual",
    "linguistics",
    "language",
    "library",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fustilio/wordnet-playground.git",
    "directory": "wn-ts"
  },
  "private": true,
  "license": "MIT",
  "author": "fustilio",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./shared": {
      "types": "./dist/src/shared/index.d.ts",
      "default": "./dist/src/shared/index.js"
    },
    "./utils": {
      "types": "./dist/src/utils/index.d.ts",
      "default": "./dist/src/utils/index.js"
    },
    "./test": {
      "types": "./src/test/index.ts",
      "default": "./src/test/index.ts"
    },
    "./plugins": {
      "types": "./dist/src/plugins/index.d.ts",
      "default": "./dist/src/plugins/index.js"
    },
    "./plugins/microkernel": {
      "types": "./dist/src/plugins/microkernel/index.d.ts",
      "default": "./dist/src/plugins/microkernel/index.js"
    },
    "./index.json": "./src/index.json",
    "./lmf": {
      "types": "./dist/src/lmf/index.d.ts",
      "default": "./dist/src/lmf/index.js"
    }
  },
  "files": [
    "tools/"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "format": "prettier --write src/**/*.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "pnpm run test:func",
    "test:bench": "vitest bench --run",
    "test:coverage": "vitest run --coverage --reporter=verbose --exclude \"**/*e2e.test.ts\"",
    "test:func": "vitest run --reporter=verbose --exclude \"**/*e2e.test.ts\"",
    "test:lmf": "pnpm vitest run lmf",
    "test:ui": "vitest --ui --exclude \"**/*e2e.test.ts\"",
    "typecheck": "tsc --noEmit",
    "vitest": "pnpm with-debug-logs vitest run",
    "with-debug-logs": "cross-env WN_TS_LOG_LEVEL=5",
    "generate-test-data": "tsx scripts/generate-test-data.ts",
    "validate-urls": "tsx scripts/generate-test-data.ts --validate-only",
    "analyze-wordnet-urls": "tsx scripts/analyze-wordnet-urls.ts"
  },
  "dependencies": {
    "kysely": "catalog:",
    "sax": "^1.4.1",
    "smol-toml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@types/node": "catalog:",
    "@types/sax": "^1.2.7",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "^3.2.4",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "pythonia": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "xml-introspect": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
