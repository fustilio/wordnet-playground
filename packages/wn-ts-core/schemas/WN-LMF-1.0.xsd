 <element name='SenseRelation'>
  <complexType>
   <attribute name='target' type='IDREF' use='required'/>
   <attribute name='relType' use='required'>
    <simpleType>
     <restriction base='string'>
      <enumeration value='antonym'/>
      <enumeration value='also'/>
      <enumeration value='participle'/>
      <enumeration value='pertainym'/>
      <enumeration value='derivation'/>
      <enumeration value='domain_topic'/>
      <enumeration value='has_domain_topic'/>
      <enumeration value='domain_region'/>
      <enumeration value='has_domain_region'/>
      <enumeration value='exemplifies'/>
      <enumeration value='is_exemplified_by'/>
      <enumeration value='similar'/>
      <enumeration value='other'/>
     </restriction>
    </simpleType>
   </attribute>
   <attribute name='dc:contributor' type='string' use='optional'/>
   <attribute name='dc:coverage' type='string' use='optional'/>
   <attribute name='dc:creator' type='string' use='optional'/>
