 <element name='SyntacticBehaviour'>
  <complexType>
   <attribute name='subcategorizationFrame' type='string' use='required'/>
   <attribute name='senses' type='IDREFS' use='optional'/>
  </complexType>
 </element>

 <element name='Count'>
  <complexType mixed='true'>
   <attribute name='dc:contributor' type='string' use='optional'/>
