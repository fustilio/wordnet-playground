{
  "name": "wn-ts-node",
  "version": "1.0.0",
  "description": "Wordnet interface library - TypeScript port",
  "keywords": [
    "wordnet",
    "interlingual",
    "linguistics",
    "language",
    "library",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fustilio/wordnet-playground.git",
    "directory": "wn-ts"
  },
  "license": "MIT",
  "author": "fustilio",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./low-level": {
      "types": "./dist/low-level/index.d.ts",
      "default": "./dist/low-level/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "default": "./dist/plugins/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy/index.d.ts",
      "default": "./dist/legacy/index.js"
    }
  },
  "bin": {
    "wn-ts": "./bin/cli-stub.js"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "scripts": {
    "bench:bilingual": "node scripts/run-bilingual-benchmarks.js",
    "prebuild": "pnpm run clean",
    "build": "vite build && pnpm run copy-assets",
    "clean": "rimraf dist",
    "copy-assets": "cp ../wn-ts-core/src/index.toml dist/",
    "dev": "pnpm run copy-assets && tsc --watch",
    "format": "prettier --write src/**/*.ts",
    "generate-test-data": "cd ../wn-ts-core && pnpm run generate-test-data",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "publish-package": "pnpm run build && changeset version && changeset publish",
    "test": "pnpm run test:func",
    "test:full": "pnpm run test:func && pnpm run test:e2e",
    "test:bench": "vitest bench --run",
    "test:coverage": "vitest run --coverage --reporter=verbose --exclude \"**/*e2e.test.ts\"",
    "test:e2e": "pnpm with-debug-logs vitest run --no-file-parallelism tests/e2e",
    "test:func": "vitest run --reporter=verbose --exclude \"**/*e2e.test.ts\"",
    "test:ui": "vitest --ui --exclude \"**/*e2e.test.ts\"",
    "test:validation": "pnpm vitest validation",
    "typecheck": "tsc --noEmit",
    "validate-urls": "cd ../wn-ts-core && pnpm run validate-urls",
    "vitest": "pnpm with-debug-logs vitest run",
    "with-debug-logs": "cross-env WN_TS_LOG_LEVEL=5"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "kysely": "catalog:",
    "lzma-native": "^8.0.6",
    "sax": "^1.4.1",
    "smol-toml": "catalog:",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@types/sax": "^1.2.7",
    "@types/tar-stream": "^3.1.4",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "^3.2.4",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "wn-ts-core": "workspace:*"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}