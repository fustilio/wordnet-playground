{
  "name": "wn-ts-web",
  "version": "0.6.0",
  "description": "Browser/web distribution and interactive demo for wn-ts. Implements the node-to-browser strategy for WordNet access in the browser, following the approach of wordpos/wordpos-web.",
  "keywords": [
    "wordnet",
    "interlingual",
    "linguistics",
    "language",
    "typescript",
    "browser",
    "web",
    "demo",
    "wn-ts"
  ],
  "homepage": "https://github.com/fustilio/wordnet-playground/tree/main/wn-ts-web",
  "repository": {
    "type": "git",
    "url": "https://github.com/fustilio/wordnet-playground.git",
    "directory": "wn-ts-web"
  },
  "license": "MIT",
  "author": "fustilio",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/wn-ts-web.d.ts",
      "import": "./dist/wn-ts-web.mjs",
      "default": "./dist/wn-ts-web.mjs"
    },
    "./react": {
      "types": "./dist/wn-ts-web-react.d.ts",
      "import": "./dist/wn-ts-web-react.mjs",
      "default": "./dist/wn-ts-web-react.mjs"
    },
    "./worker": {
      "types": "./dist/wordnet-worker.d.ts",
      "import": "./dist/wordnet-worker.mjs",
      "default": "./dist/wordnet-worker.mjs"
    }
  },
  "main": "./dist/wn-ts-web.mjs",
  "types": "./dist/wn-ts-web.d.ts",
  "scripts": {
    "bench": "pnpm with-memory-limit vitest --config=vitest.e2e.config.ts bench --run",
    "prebuild": "cd ../wn-data-loader && pnpm run build:data-sources",
    "build": "vite build",
    "build:dev": "vite build --config vite.dev.config.ts",
    "build:watch": "vite build --watch",
    "clean": "rimraf dist",
    "dev": "pnpm build:dev --watch",
    "introspect": "xml-introspect",
    "introspect:preview": "xml-introspect preview https://github.com/omwn/omw-data/releases/download/v1.4/omw-fr-1.4.tar.xz --verbose",
    "introspect:schema": "xml-introspect schema https://github.com/omwn/omw-data/releases/download/v1.4/omw-fr-1.4.tar.xz --verbose omw-fr-1.4.xsd",
    "introspect:validate": "xml-introspect validate https://github.com/omwn/omw-data/releases/download/v1.4/omw-fr-1.4.tar.xz ./omw-fr-1.4.xsd --verbose",
    "test": "pnpm test:node && pnpm test:browser && pnpm test:e2e",
    "test:browser": "pnpm with-memory-limit vitest --config=vitest.browser.config.ts --run",
    "test:browser:watch": "vitest --config=vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm with-memory-limit vitest --config=vitest.e2e.config.ts --run",
    "test:e2e:lexicon": "pnpm with-memory-limit vitest --config=vitest.e2e.config.ts --run test/browser/e2e/lexicon-preview.e2e.test.ts",
    "test:e2e:orchestration": "pnpm with-memory-limit vitest --config=vitest.e2e.config.ts --run test/browser/e2e/orchestrator.e2e.test.ts test/browser/e2e/worker-client.e2e.test.ts",
    "test:e2e:stats": "pnpm with-memory-limit vitest --config=vitest.e2e.config.ts --run test/browser/e2e/statistics-stress.test.ts",
    "test:lmf": "pnpm test:browser lmf",
    "test:node": "pnpm with-memory-limit vitest run",
    "test:offline": "pnpm test:node && pnpm test:browser",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "vitest": "pnpm with-memory-limit vitest run",
    "with-memory-limit": "cross-env NODE_OPTIONS=--max-old-space-size=16384"
  },
  "dependencies": {
    "comlink": "catalog:",
    "fast-xml-parser": "^5.2.5",
    "kysely": "catalog:",
    "kysely-sqlite-builder": "^1.0.0",
    "kysely-wasm": "^1.2.1",
    "sqlite-wasm-kysely": "^0.3.0",
    "utils": "workspace:*",
    "wn-data-loader": "workspace:*",
    "wn-ts-core": "workspace:*",
    "xml-introspect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@sqlite.org/sqlite-wasm": "catalog:",
    "@types/lzma": "^2.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "playwright": "^1.54.1",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-comlink": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@sqlite.org/sqlite-wasm": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
