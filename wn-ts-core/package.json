{
  "name": "wn-ts-core",
  "version": "0.5.0",
  "description": "Wordnet interface library - TypeScript port",
  "keywords": [
    "wordnet",
    "interlingual",
    "linguistics",
    "language",
    "library",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fustilio/wordnet-playground.git",
    "directory": "wn-ts"
  },
  "license": "MIT",
  "author": "fustilio",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    }
  },
  "scripts": {
    "format": "prettier --write src/**/*.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "pnpm run test:func",
    "test:func": "vitest run --reporter=verbose --exclude \"**/*e2e.test.ts\"",
    "test:bench": "vitest bench --run",
    "test:coverage": "vitest run --coverage --reporter=verbose --exclude \"**/*e2e.test.ts\"",
    "test:ui": "vitest --ui --exclude \"**/*e2e.test.ts\"",
    "vitest": "pnpm with-debug-logs vitest run",
    "with-debug-logs": "cross-env WN_TS_LOG_LEVEL=5"
  },
  "files": [
    "tools/"
  ],
  "dependencies": {
    "@types/sax": "^1.2.7",
    "commander": "^14.0.0",
    "fast-xml-parser": "^5.2.5",
    "lzma-native": "^8.0.6",
    "sax": "^1.4.1",
    "smol-toml": "^1.4.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "pythonia": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "^3.2.4",
    "cross-env": "^7.0.3",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
