{
  "name": "wn-ts-web-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "pnpm test:cypress",
    "test:cypress": "start-server-and-test dev http://localhost:5173 cypress:run --config-file cypress.wordnet.config.mjs",
    "test:cypress:all": "start-server-and-test dev http://localhost:5173 cypress:run",
    "test:cypress:wordnet": "start-server-and-test dev http://localhost:5173 cypress:run --config-file cypress.wordnet.config.mjs",
    "test:cypress:examples": "start-server-and-test dev http://localhost:5173 cypress:run --spec cypress/e2e/1-getting-started/todo.cy.ts",
    "cypress": "start-server-and-test dev http://localhost:5173 cypress:open",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "catalog:",
    "@tailwindcss/vite": "^4.1.11",
    "pako": "^2.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "wn-ts-web": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.2.0",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "cypress": "^14.5.3",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "start-server-and-test": "^2.0.13",
    "typescript": "catalog:",
    "typescript-eslint": "^8.35.1",
    "vite": "catalog:"
  }
}
