{
  "name": "wn-ts-web",
  "version": "0.5.0",
  "description": "Browser/web distribution and interactive demo for wn-ts. Implements the node-to-browser strategy for WordNet access in the browser, following the approach of wordpos/wordpos-web.",
  "keywords": [
    "wordnet",
    "interlingual",
    "linguistics",
    "language",
    "typescript",
    "browser",
    "web",
    "demo",
    "wn-ts"
  ],
  "homepage": "https://github.com/fustilio/wordnet-playground/tree/main/wn-ts-web",
  "repository": {
    "type": "git",
    "url": "https://github.com/fustilio/wordnet-playground.git",
    "directory": "wn-ts-web"
  },
  "license": "MIT",
  "author": "fustilio",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/wn-ts-web.mjs"
    }
  },
  "scripts": {
    "prebuild": "pnpm run build:index",
    "build": "vite build",
    "build:index": "node scripts/build-index.js",
    "build:watch": "vite build --watch",
    "clean": "rimraf dist",
    "dev": "vite build --watch",
    "test": "pnpm test:node && pnpm test:browser",
    "test:browser": "npx --node-options=--max-old-space-size=16384 vitest --config=vitest.browser.config.ts --run",
    "test:browser:opfs": "npx --node-options=--max-old-space-size=8192 vitest --config=vitest.browser.config.ts --run test/browser/opfs-manager.test.ts",
    "test:browser:sqlite": "npx --node-options=--max-old-space-size=8192 vitest --config=vitest.browser.config.ts --run test/browser/sqlite-wasm-browser.test.ts",
    "test:browser:watch": "vitest --config=vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx --node-options=--max-old-space-size=16384 vitest --config=vitest.browser.config.ts --run e2e",
    "test:node": "npx --node-options=--max-old-space-size=16384 vitest run",
    "test:node:all": "npx --node-options=--max-old-space-size=16384 vitest run",
    "test:node:core": "npx --node-options=--max-old-space-size=8192 vitest run test/factory.test.ts test/kysely-integration.test.ts test/demo-utils.test.ts test/web-database-simple.test.ts",
    "test:node:fast": "npx --node-options=--max-old-space-size=8192 vitest run test/factory.test.ts test/kysely-integration.test.ts test/demo-utils.test.ts",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "vitest": "npx --node-options=--max-old-space-size=16384 vitest run"
  },
  "dependencies": {
    "kysely": "^0.28.3",
    "kysely-sqlite-builder": "^1.0.0",
    "kysely-wasm": "^1.2.1",
    "smol-toml": "^1.4.1",
    "sqlite-wasm-kysely": "^0.3.0",
    "wn-ts-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@sqlite.org/sqlite-wasm": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint": "catalog:",
    "playwright": "^1.54.1",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@sqlite.org/sqlite-wasm": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
